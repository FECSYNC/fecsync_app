model PosProduct {
  id                    String         @id @default(cuid())
  orgId                 String
  locationId            String
  kind                  PosProductKind
  name                  String
  description           String?
  sku                   String?
  price                 Decimal        @default(0) @db.Decimal(12, 2)
  openPrice             Boolean        @default(false)
  taxExemptDefault      Boolean        @default(false)
  trackInventory        Boolean        @default(false)
  onHand                Int?
  suspendSales          Boolean        @default(false)
  archivedAt            DateTime?
  images                String[]       @default([])
  kitchenRoute          String?
  membershipPlanId      String?
  admissionProductId    String?
  giftCardDefaultAmount Decimal?       @db.Decimal(12, 2)
  denominations         Json?
  allowCustomAmount     Boolean        @default(false)
  /// Weighted average unit cost (accounting inventory). Quantity stays in onHand.
  avgCost               Decimal        @default(0) @db.Decimal(18, 4)
  lastCost              Decimal?       @db.Decimal(18, 4)
  inventoryAccountId    String?
  cogsAccountId         String?
  revenueAccountId      String?
  reorderLevel          Int?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  org              Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location         VenueLocation      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  inventoryMovements InventoryMovement[]
  membershipPlan   MembershipPlan?    @relation(fields: [membershipPlanId], references: [id], onDelete: SetNull)
  admissionProduct AdmissionProduct?  @relation("PosAdmissionProxy", fields: [admissionProductId], references: [id], onDelete: SetNull)
  modifierGroups   PosModifierGroup[]
  parentLinks      PosProductLink[]   @relation("PosLinkParent")
  childLinks       PosProductLink[]   @relation("PosLinkChild")
  menuItems        PosMenuItem[]
  wastage          PosWastage[]

  @@index([orgId, locationId, createdAt])
  @@index([orgId, kind, archivedAt])
  @@index([orgId, admissionProductId])
  @@map("pos_products")
}

