  reopenedAt   DateTime?
  reopenedById String?
  reopenReason String?
  lockedAt     DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  org      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  entries  JournalEntry[]
  balances AccountBalance[]

  @@unique([orgId, fiscalYear, periodNumber])
  @@index([orgId, startsOn])
  @@index([orgId, status])
  @@map("accounting_periods")
}

model JournalEntry {
  id              String               @id @default(cuid())
  orgId           String
  number          String
  entryDate       DateTime
  originalDate    DateTime?
  lateForPeriodId String?
  periodId        String
  status          JournalStatus        @default(draft)
  kind            JournalKind          @default(manual)
  sourceType      AccountingSourceType @default(manual)
  sourceId        String?
  sourceEvent     String?
  idempotencyKey  String?
  memo            String?
  reference       String?
  currency        String
  exchangeRate    Decimal              @default(1) @db.Decimal(18, 8)
  totalDebit      Decimal              @default(0) @db.Decimal(18, 2)
  totalCredit     Decimal              @default(0) @db.Decimal(18, 2)
  locationId      String?
  attachments     Json?
  createdById     String?
  submittedById   String?
  submittedAt     DateTime?
  approvedById    String?
  approvedAt      DateTime?
  rejectedById    String?
  rejectedReason  String?
  postedById      String?
  postedAt        DateTime?
  reversalOfId    String?              @unique
  reversedById    String?
  reversedAt      DateTime?
  reversalReason  String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  org        Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  period     AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  location   VenueLocation?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  reversalOf JournalEntry?    @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy JournalEntry?    @relation("JournalReversal")
  lines      JournalLine[]

  @@unique([orgId, number])
  @@unique([orgId, idempotencyKey])
  @@index([orgId, entryDate])
  @@index([orgId, status])
  @@index([orgId, sourceType, sourceId])
  @@index([orgId, periodId])
  @@index([orgId, locationId, entryDate])
  @@map("journal_entries")
}

model JournalLine {
  id              String               @id @default(cuid())
  orgId           String
  entryId         String
  lineNo          Int
  ledgerAccountId String
  locationId      String?
  entryDate       DateTime
  debit           Decimal              @default(0) @db.Decimal(18, 2)
  credit          Decimal              @default(0) @db.Decimal(18, 2)
  foreignAmount   Decimal?             @db.Decimal(18, 2)
  foreignCurrency String?
  description     String?
  partyType       AccountingPartyType?
  guestProfileId  String?
  bookingAccountId String?
  customerUserId  String?
  supplierId      String?
  employeeUserId  String?
  taxCodeId       String?
  taxBaseAmount   Decimal?             @db.Decimal(18, 2)
  bookingId       String?
  posSaleId       String?
  invoiceId       String?
  supplierBillId  String?
  expenseId       String?
  posProductId    String?
  shopProductId   String?
  reconciledInId  String?
  createdAt       DateTime             @default(now())

  org           Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  entry         JournalEntry        @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account       LedgerAccount       @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  location      VenueLocation?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  reconciledIn  BankReconciliation? @relation(fields: [reconciledInId], references: [id], onDelete: SetNull)
  bankMatches   BankTransactionMatch[]

  @@index([orgId, ledgerAccountId, entryDate])
  @@index([orgId, locationId, entryDate])
  @@index([orgId, guestProfileId])
  @@index([orgId, bookingAccountId])
  @@index([orgId, customerUserId])
  @@index([orgId, supplierId])
  @@index([orgId, employeeUserId])
  @@index([orgId, bookingId])
  @@index([orgId, posSaleId])
  @@index([orgId, invoiceId])
  @@index([entryId])
