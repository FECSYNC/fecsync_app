/// Multi-park / multi-venue site under an Organization (tenant HQ).
/// Future Ticketing / POS / Waivers attach via orgId (+ optional locationId).
/// Not created automatically on register/approve ? admin creates after entitled.
model VenueLocation {
  id                    String              @id @default(cuid())
  orgId                 String
  name                  String
  slug                  String
  status                VenueLocationStatus @default(active)
  /// Set when status ? archived; cleared on reactivate. Frees venues quota while archived.
  archivedAt            DateTime?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  region                String?
  postalCode            String?
  country               String?
  timezone              String?
  /// When true, public /book APIs may list this venue (Phase 2).
  publicBookingEnabled  Boolean             @default(false)
  /// Franchise unit under the parent Organization (Option A). Not a second tenant.
  isFranchise           Boolean             @default(false)
  /// Optional public display name override for franchise-facing surfaces.
  franchiseDisplayName  String?
  franchiseSupportPhone String?
  franchiseSupportEmail String?
  /// Operator notes or franchise code (not a SaaS billing id).
  franchiseCode         String?
  franchiseNotes        String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  membershipAssignments  MembershipVenueAssignment[]
  products               Product[]
  orders                 Order[]
  bookingSettings        BookingSettings[]
  capacityResources      CapacityResource[]
  admissionProducts      AdmissionProduct[]
  admissionProductPrices AdmissionProductPrice[]
  admissionAddOnLinks    AdmissionAddOnLink[]
  stockPeriods           StockPeriod[]
  ticketSessions         TicketSession[]
  bookings               Booking[]
  bookingHolds           BookingHold[]
  ticketCredentials      TicketCredential[]
  bookingPayments        BookingPayment[]
  bookingPaymentLinks    BookingPaymentLink[]
  bookingInvoices        BookingInvoice[]
  bookingAccounts        BookingAccount[]
  bookingActivities      BookingActivity[]
  bookingPackages        BookingPackage[]
  partyDetails           PartyBookingDetail[]
  partyGuests            PartyGuest[]
  partyInvitations       PartyInvitation[]
  partyRunSheetItems     PartyRunSheetItem[]
  partySettings          PartySettings[]
  partyPackageConfigs    PartyPackageConfig[]
  partyMenuItems         PartyMenuItem[]
  partyFoodOrders        PartyFoodOrder[]
  partyFoodLines         PartyFoodLine[]
