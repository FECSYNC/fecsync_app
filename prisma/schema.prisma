  enabledAt                        DateTime?
  baseCurrency                     String                      @default("USD")
  timezone                         String                      @default("UTC")
  fiscalYearStartMonth             Int                         @default(1)
  goLiveDate                       DateTime
  bookingRevenueRecognition        RevenueRecognitionPolicy    @default(on_confirm)
  membershipRecognition            MembershipRecognitionPolicy @default(on_payment)
  requireApprovalForManualJournals Boolean                     @default(true)
  manualJournalApprovalThreshold   Decimal?                    @db.Decimal(18, 2)
  expenseApprovalThreshold         Decimal?                    @db.Decimal(18, 2)
  billApprovalThreshold            Decimal?                    @db.Decimal(18, 2)
  supplierPaymentApprovalThreshold Decimal?                    @db.Decimal(18, 2)
  allowSelfApproval                Boolean                     @default(false)
  receiptRequiredAbove             Decimal?                    @db.Decimal(18, 2)
  defaultPaymentTermsDays          Int                         @default(30)
  invoiceReminderOffsets           Json                        @default("[-3,0,7,14,30]")
  billReminderDaysBefore           Json                        @default("[3,1]")
  postShopOrders                   Boolean                     @default(true)
  postTailoringJobs                Boolean                     @default(true)
  giftCardBreakageOnExpiry         Boolean                     @default(false)
  allowNegativeStock               Boolean                     @default(true)
  statementFooter                  String?
  /// Opening balance entry version (re-save reverses previous).
  openingBalanceVersion            Int                         @default(0)
  lastDigestAt                     DateTime?
  createdById                      String?
  updatedById                      String?
  createdAt                        DateTime                    @default(now())
  updatedAt                        DateTime                    @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("accounting_settings")
}

model LedgerAccount {
  id                 String               @id @default(cuid())
  orgId              String
  code               String
  name               String
  type               LedgerAccountType
  subtype            LedgerAccountSubtype
  systemKey          AccountingSystemKey?
  parentId           String?
  isHeader           Boolean              @default(false)
  isActive           Boolean              @default(true)
  archivedAt         DateTime?
  locationId         String?
  currency           String?
  description        String?
  cashFlowCategory   CashFlowCategory     @default(operating)
  allowManualPosting Boolean              @default(true)
  defaultTaxCodeId   String?
  sortOrder          Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  org      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location VenueLocation?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  parent   LedgerAccount?  @relation("LedgerAccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children LedgerAccount[] @relation("LedgerAccountTree")
  lines    JournalLine[]
  balances AccountBalance[]
  mappings AccountingMapping[]
  bankAccount BankAccount?

  @@unique([orgId, code])
  @@unique([orgId, systemKey])
  @@index([orgId, type, isActive])
  @@index([orgId, parentId])
  @@map("ledger_accounts")
}

model AccountingPeriod {
  id           String                 @id @default(cuid())
  orgId        String
  fiscalYear   Int
  periodNumber Int
  startsOn     DateTime
  endsOn       DateTime
  status       AccountingPeriodStatus @default(open)
