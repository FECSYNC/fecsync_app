// ??? Online Booking / Ticketing ??????????????????????????????????????????????

/// Per-location booking behavior; locationId null = org-wide default.
model BookingSettings {
  id                         String            @id @default(cuid())
  orgId                      String
  locationId                 String?
  defaultCreateMode          BookingCreateMode @default(hold)
  holdTtlMinutes             Int               @default(15)
  reserveTtlHours            Int               @default(24)
  requireReviewBeforeConfirm Boolean           @default(false)
  allowOnlinePayLater        Boolean           @default(false)
  /// When true, online pay-later may mark booking confirmed (Phase 2 engine).
  payLaterMarksConfirmed     Boolean           @default(false)
  pastEditGraceMinutes       Int               @default(0)
  cancelCutoffMinutes        Int?
  defaultTaxExempt           Boolean           @default(false)
  smsEnabled                 Boolean           @default(false)
  /// 12-hour AM/PM vs 24-hour clocks for this org default or venue override.
  timeFormat                 TimeClockFormat   @default(twelve_hour)
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  org      Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location VenueLocation? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([orgId, locationId])
  @@index([orgId])
  @@map("booking_settings")
}

model CapacityResource {
  id              String               @id @default(cuid())
  orgId           String
  locationId      String
  name            String
  type            CapacityResourceType @default(other)
  defaultCapacity Int                  @default(0)
  archivedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  org                 Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location            VenueLocation        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  products            AdmissionProduct[]
  sessions            TicketSession[]
  bookingLines        BookingLine[]
  partyDetails        PartyBookingDetail[]
  partyPackageConfigs PartyPackageConfig[] @relation("PartyPackageRoom")

  @@index([orgId, locationId])
  @@index([orgId, archivedAt])
  @@map("capacity_resources")
}

model AdmissionProduct {
  id                    String               @id @default(cuid())
  orgId                 String
  locationId            String
  /// Optional BookingCategory folder (NOT shop ProductCategory). Null = uncategorized.
  categoryId            String?
  type                  AdmissionProductType
  name                  String
  description           String?
  images                String[]             @default([])
  resourceId            String?
  published             Boolean              @default(false)
  /// When true, evaluateWaiver treats this admission product as requiring a signed waiver.
  waiverRequired        Boolean              @default(false)
  minGuests             Int?
  maxGuests             Int?
  defaultPassExpiryDays Int?
  taxExemptDefault      Boolean              @default(false)
  archivedAt            DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  org              Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location         VenueLocation           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  /// Soft-archive of BookingCategory SetNulls this FK; active assign uses resolveBookingCategoryId.
  category         BookingCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  resource         CapacityResource?       @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  prices           AdmissionProductPrice[]
  parentLinks      AdmissionAddOnLink[]    @relation("AddOnParent")
  addOnLinks       AdmissionAddOnLink[]    @relation("AddOnChild")
  stockPeriodLinks StockPeriodProduct[]
  sessions         TicketSession[]
  bookingLines     BookingLine[]
  partyDetails     PartyBookingDetail[]
  partyConfig      PartyPackageConfig?
  posProxies       PosProduct[]            @relation("PosAdmissionProxy")

  @@index([orgId, locationId])
  @@index([orgId, type, archivedAt])
  @@index([orgId, published])
  @@index([orgId, categoryId])
  @@map("admission_products")
}

model AdmissionProductPrice {
  id         String    @id @default(cuid())
  orgId      String
  locationId String
  productId  String
  /// Band code e.g. adult / child / infant / group
  code       String
  amount     Decimal   @db.Decimal(12, 2)
  currency   String    @default("USD")
  minAge     Int?
  maxAge     Int?
  validFrom  DateTime?
  validTo    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  org      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location VenueLocation    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product  AdmissionProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, code])
  @@index([orgId, productId])
  @@index([productId])
  @@map("admission_product_prices")
}

model AdmissionAddOnLink {
  id              String   @id @default(cuid())
  orgId           String
  locationId      String
  parentProductId String
  addOnProductId  String
  required        Boolean  @default(false)
  maxQty          Int?
  stockPeriodId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org           Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location      VenueLocation    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  parentProduct AdmissionProduct @relation("AddOnParent", fields: [parentProductId], references: [id], onDelete: Cascade)
  addOnProduct  AdmissionProduct @relation("AddOnChild", fields: [addOnProductId], references: [id], onDelete: Cascade)
  stockPeriod   StockPeriod?     @relation(fields: [stockPeriodId], references: [id], onDelete: SetNull)

  @@unique([parentProductId, addOnProductId])
  @@index([orgId, locationId])
  @@map("admission_addon_links")
}

model StockPeriod {
  id         String          @id @default(cuid())
  orgId      String
  locationId String
  startsAt   DateTime
  endsAt     DateTime
  kind       StockPeriodKind @default(available)
  /// Optional remaining / cap quantity for available periods.
  quantity   Int?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  org        Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location   VenueLocation        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  products   StockPeriodProduct[]
  addOnLinks AdmissionAddOnLink[]

  @@index([orgId, locationId, startsAt])
  @@map("stock_periods")
}

model StockPeriodProduct {
  id            String @id @default(cuid())
  stockPeriodId String
  productId     String

  stockPeriod StockPeriod      @relation(fields: [stockPeriodId], references: [id], onDelete: Cascade)
  product     AdmissionProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([stockPeriodId, productId])
  @@index([productId])
  @@map("stock_period_products")
}

model TicketSession {
  id            String   @id @default(cuid())
  orgId         String
  locationId    String
  productId     String
  resourceId    String?
  /// Guest-facing slot name, e.g. "Morning Adventure".
  label         String?
  startsAt      DateTime
  endsAt        DateTime
  capacity      Int
  remaining     Int
  priceOverride Decimal? @db.Decimal(12, 2)
  isClosed      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org          Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location     VenueLocation     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product      AdmissionProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  resource     CapacityResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  bookingLines BookingLine[]
  bookingHolds BookingHold[]

  @@index([orgId, locationId, startsAt])
  @@index([productId, startsAt])
  @@index([orgId, isClosed])
  @@map("ticket_sessions")
}

model Booking {
  id                  String            @id @default(cuid())
  publicId            String            @unique
  orgId               String
  locationId          String
  status              BookingStatus     @default(draft)
  channel             BookingChannel    @default(online)
  createMode          BookingCreateMode @default(hold)
  userId              String?
  accountId           String?
  primaryContactName  String?
  primaryContactEmail String?
  primaryContactPhone String?
  assignedStaffUserId String?
  taxExempt           Boolean           @default(false)
  taxExemptReason     String?
  subtotal            Decimal           @default(0) @db.Decimal(12, 2)
  taxAmount           Decimal           @default(0) @db.Decimal(12, 2)
  total               Decimal           @default(0) @db.Decimal(12, 2)
  amountPaid          Decimal           @default(0) @db.Decimal(12, 2)
  amountDue           Decimal           @default(0) @db.Decimal(12, 2)
  notes               String?
  posNotes            String?
  reviewedAt          DateTime?
  reviewedById        String?
  holdExpiresAt       DateTime?
  reservedUntil       DateTime?
  visitStartsAt       DateTime?
  visitEndsAt         DateTime?
  cancelledAt         DateTime?
  reactivatedAt       DateTime?
  createdById         String?
  updatedById         String?
  confirmationSentAt  DateTime?
  /// Guest confirmation / view token (opaque).
  viewToken           String            @unique @default(cuid())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  org             Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location        VenueLocation        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user            User?                @relation("BookingGuestUser", fields: [userId], references: [id], onDelete: SetNull)
  account         BookingAccount?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  assignedStaff   User?                @relation("BookingAssignedStaff", fields: [assignedStaffUserId], references: [id], onDelete: SetNull)
  reviewedBy      User?                @relation("BookingReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdBy       User?                @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?                @relation("BookingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  lines           BookingLine[]
  guests          BookingGuest[]
  holds           BookingHold[]
  credentials     TicketCredential[]
  payments        BookingPayment[]
  paymentLinks    BookingPaymentLink[]
  invoices        BookingInvoice[]
  activities      BookingActivity[]
  partyDetail     PartyBookingDetail?
  giftCardsIssued GiftCard[]
  waiverRecords   WaiverRecord[]
  posSaleLinks    PosSaleBooking[]

  @@index([orgId, locationId, status])
  @@index([orgId, locationId, visitStartsAt])
  @@index([orgId, locationId, amountDue])
  @@index([orgId, visitStartsAt])
  @@index([orgId, publicId])
  @@index([orgId, primaryContactEmail])
  @@index([orgId, primaryContactPhone])
  @@index([accountId])
  @@map("bookings")
}

model BookingLine {
  id            String               @id @default(cuid())
  bookingId     String
  orgId         String
  productId     String?
  /// Snapshot fields (survive product archive/edit).
  productName   String
  productType   AdmissionProductType
  priceBandCode String?
  qty           Int                  @default(1)
  unitPrice     Decimal              @db.Decimal(12, 2)
  taxAmount     Decimal              @default(0) @db.Decimal(12, 2)
  lineTotal     Decimal              @db.Decimal(12, 2)
  resourceId    String?
  sessionId     String?
  visitDate     DateTime?
  passExpiresAt DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  booking  Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  product  AdmissionProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  resource CapacityResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  session  TicketSession?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  guests   BookingGuest[]

  @@index([bookingId])
  @@index([orgId, productId])
  @@map("booking_lines")
}

model BookingGuest {
  id            String          @id @default(cuid())
  bookingId     String
  bookingLineId String?
  name          String?
  ageBand       String?
  partyRole     PartyGuestRole?
  credentialId  String?         @unique
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  booking     Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingLine BookingLine?      @relation(fields: [bookingLineId], references: [id], onDelete: SetNull)
  credential  TicketCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  partyGuest  PartyGuest?

  @@index([bookingId])
  @@map("booking_guests")
}

model BookingHold {
  id         String   @id @default(cuid())
  orgId      String
  locationId String
  bookingId  String?
  sessionId  String?
  resourceId String?
  qty        Int      @default(1)
  token      String   @unique @default(cuid())
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  org      Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location VenueLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  booking  Booking?       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  session  TicketSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([orgId, locationId, expiresAt])
  @@index([sessionId])
  @@map("booking_holds")
}

model TicketCredential {
  id             String                 @id @default(cuid())
  orgId          String
  locationId     String
  bookingId      String
  code           String
  qrPayload      String
  status         TicketCredentialStatus @default(unused)
  customTicketId String?
  passExpiresAt  DateTime?
  redeemedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  org      Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location VenueLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  booking  Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  guest    BookingGuest?

  @@unique([orgId, code])
  @@index([orgId, locationId, status])
  @@index([bookingId])
  @@index([orgId, customTicketId])
  @@map("ticket_credentials")
}

model BookingPayment {
  id                    String               @id @default(cuid())
  orgId                 String
  locationId            String
  bookingId             String
  tender                BookingPaymentTender
  amount                Decimal              @db.Decimal(12, 2)
  currency              String               @default("USD")
  status                BookingPaymentStatus @default(pending)
  stripePaymentIntentId String?
  stripeChargeId        String?
  /// Connect destination snapshot when settled as park/org destination charge (Step 3).
  connectedAccountId    String?
  /// Platform application fee (minor units) when Connect destination was used.
  platformFeeMinor      Int?
  /// Stripe payment_method fingerprint for staff search only ? never export.
  cardFingerprint       String?
  giftCardId            String?
  receivedByStaffId     String?
  splitGroupId          String?
  /// Cumulative amount already refunded against this tender (supports partial_refund).
  amountRefunded        Decimal              @default(0) @db.Decimal(12, 2)
  receiptEmailSentAt    DateTime?
  /// Allocation from a POS sale. Same Stripe PaymentIntent as PosSalePayment — not a second charge.
  posSaleId             String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  org             Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location        VenueLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  giftCard        GiftCard?     @relation(fields: [giftCardId], references: [id], onDelete: SetNull)
  receivedByStaff User?         @relation("BookingPaymentReceivedBy", fields: [receivedByStaffId], references: [id], onDelete: SetNull)

  @@index([orgId, bookingId])
  @@index([orgId, status])
  @@index([orgId, cardFingerprint])
  @@index([orgId, stripePaymentIntentId])
  @@map("booking_payments")
}

model BookingPaymentLink {
  id         String             @id @default(cuid())
  orgId      String
  locationId String
  bookingId  String
  token      String             @unique @default(cuid())
  amountDue  Decimal            @db.Decimal(12, 2)
  expiresAt  DateTime
  channel    PaymentLinkChannel @default(email)
  sentTo     String?
  createdAt  DateTime           @default(now())

  org      Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location VenueLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  booking  Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([orgId, bookingId])
  @@map("booking_payment_links")
}

model BookingInvoice {
  id           String        @id @default(cuid())
  orgId        String
  locationId   String
  bookingId    String?
  accountId    String?
  /// Unique per org ? format INV-{orgSlug}-{seq} (engine Phase 2+).
  number       String
  status       InvoiceStatus @default(draft)
  amount       Decimal       @default(0) @db.Decimal(12, 2)
  currency     String        @default("USD")
  dueAt        DateTime?
  sentAt       DateTime?
  voidedAt     DateTime?
  pdfUrl       String?
  htmlSnapshot String?
  /// booking = AR already posted by the booking; manual / credit_note post through accounting.
  kind               InvoiceKind @default(booking)
  guestProfileId     String?
  customerUserId     String?
  customerName       String?
  customerEmail      String?
  issueDate          DateTime?
  subtotal           Decimal     @default(0) @db.Decimal(12, 2)
  taxTotal           Decimal     @default(0) @db.Decimal(12, 2)
  amountPaid         Decimal     @default(0) @db.Decimal(12, 2)
  amountDue          Decimal     @default(0) @db.Decimal(12, 2)
  paymentTermsDays   Int?
  appliesToInvoiceId String?
  journalEntryId     String?
  /// Public invoice view token (crypto random base64url).
  viewToken          String?     @unique
  writtenOffAt       DateTime?
  writeOffReason     String?
  lastReminderAt     DateTime?
  reminderCount      Int         @default(0)
  memo               String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  org      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location VenueLocation   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  booking  Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  account  BookingAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  lines       BookingInvoiceLine[]
  allocations CustomerReceiptAllocation[]

  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([orgId, kind, status])
  @@index([orgId, guestProfileId])
  @@index([orgId, customerUserId])
  @@map("booking_invoices")
}

/// Stripe customer + payment method on User or BookingAccount. Never store PAN.
model StoredPaymentMethod {
  id                    String   @id @default(cuid())
  orgId                 String
  userId                String?
  accountId             String?
  stripeCustomerId      String
  stripePaymentMethodId String
  brand                 String?
  last4                 String?
  expMonth              Int?
  expYear               Int?
  isDefault             Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  org     Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user    User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account BookingAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([orgId, userId])
  @@index([orgId, accountId])
  @@map("stored_payment_methods")
}

/// Booking and POS stored-value card. Lookup secret is codeHash. Raw code is returned once on issue.
model GiftCard {
  id                        String         @id @default(cuid())
  orgId                     String
  codeHash                  String
  last4                     String?
  kind                      GiftCardKind   @default(digital)
  status                    GiftCardStatus @default(active)
  remainingBalance          Decimal        @db.Decimal(12, 2)
  currency                  String         @default("USD")
  locationId                String?
  issuedToGuestId           String?
  issuedSaleId              String?
  issuedFromRefundBookingId String?
  expiresAt                 DateTime?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  org                     Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location                VenueLocation?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  issuedToGuest           GuestProfile?    @relation("GiftCardIssuedToGuest", fields: [issuedToGuestId], references: [id], onDelete: SetNull)
  issuedSale              PosSale?         @relation(fields: [issuedSaleId], references: [id], onDelete: SetNull)
  issuedFromRefundBooking Booking?         @relation(fields: [issuedFromRefundBookingId], references: [id], onDelete: SetNull)
  payments                BookingPayment[]
  posPayments             PosSalePayment[]
  ledger                  GiftCardLedger[]

  @@unique([orgId, codeHash])
  @@index([orgId])
  @@index([orgId, last4])
  @@index([orgId, locationId])
  @@map("gift_cards")
}

/// B2B booking company ? NOT a SaaS Organization / tenant.
model BookingAccount {
  id               String    @id @default(cuid())
  orgId            String
  /// Optional park association for HQ location scope filters.
  locationId       String?
  name             String
  billingEmail     String?
  phone            String?
  taxId            String?
