// ??? Core auth / org ?????????????????????????????????????????????????????????

model User {
  id               String    @id @default(cuid())
  legacyId         String?   @unique // Mongo ObjectId hex for migration
  uuid             String    @unique @default(uuid())
  email            String    @unique
  password         String?
  username         String?   @unique
  firstName        String?
  lastName         String?
  phoneNumber      String?
  isVerified       Boolean   @default(false)
  accountDeleted   Boolean   @default(false)
  /// Soft ops lock ? blocks sign-in / Fresh APIs; never deletes user or tenant rows.
  accountSuspended Boolean   @default(false)
  verificationCode String?
  refreshTokenJTI  String?
  authzVersion     Int       @default(0)
  googleId         String?   @unique
  lastLoginAt      DateTime?
  lastLogoutAt     DateTime?
  lastLoginIp      String?
  role             UserRole  @default(client)
  joinedAt         DateTime  @default(now())

  profile                Profile?
  memberships            Membership[]
  roleTemplatesCreated   RoleTemplate[]        @relation("RoleTemplateCreatedBy")
  roleTemplatesUpdated   RoleTemplate[]        @relation("RoleTemplateUpdatedBy")
  cart                   Cart?
  wallet                 Wallet?
  wishlist               Wishlist?
  orders                 Order[]
  reviews                Review[]
  reviewLikes            ReviewLike[]
  notifications          Notification[]
  activityLogs           ActivityLog[]
  customizations         Customization[]
  customRequests         CustomRequest[]
  measurementProfiles    MeasurementProfile[]
  tailorProfile          TailorProfile?
  tailoringJobs          TailoringJob[]        @relation("TailoringJobCustomer")
  tailorReviews          TailorReview[]
  campaignParticipations CampaignParticipant[]
  fashionChats           FashionChat[]
  fashionChatMessages    FashionChatMessage[]
  shops                  Shop[]
  membershipsUpdated     Membership[]          @relation("MembershipUpdatedBy")
  membershipsInvited     Membership[]          @relation("MembershipInvitedBy")

  // Ticketing / bookings (Phase 1+)
  bookingsAsGuest         Booking[]             @relation("BookingGuestUser")
  bookingsAssigned        Booking[]             @relation("BookingAssignedStaff")
  bookingsCreated         Booking[]             @relation("BookingCreatedBy")
  bookingsUpdated         Booking[]             @relation("BookingUpdatedBy")
  bookingsReviewed        Booking[]             @relation("BookingReviewedBy")
  bookingPaymentsReceived BookingPayment[]      @relation("BookingPaymentReceivedBy")
  bookingActivities       BookingActivity[]
  storedPaymentMethods    StoredPaymentMethod[]
  partyDetailsAsHostStaff PartyBookingDetail[]  @relation("PartyHostStaff")

  // Guest park Memberships CRM (optional User link ? never auto-created via /signup)
  guestProfilesCreated GuestProfile[] @relation("GuestProfileCreatedBy")
  guestProfilesLinked  GuestProfile[] @relation("GuestProfileUser")

  waiverTemplatesCreated  WaiverTemplate[]        @relation("WaiverTemplateCreatedBy")
  waiverVersionsPublished WaiverTemplateVersion[] @relation("WaiverVersionPublishedBy")
  waiverRecordsVoided     WaiverRecord[]          @relation("WaiverRecordVoidedBy")
  waiverRequestsCreated   WaiverRequest[]         @relation("WaiverRequestCreatedBy")
  waiverComplianceAcks    WaiverComplianceAck[]   @relation("WaiverComplianceAckBy")

  @@map("users")
}

/// Tenant root (= architecture-doc Account). Company Admin = active
/// platform_admin Membership (no ownerUserId FK ? avoids conflicting with tailor + staff).
model Organization {
  id                            String    @id @default(cuid())
  legacyId                      String?   @unique
  name                          String
  slug                          String    @unique
  status                        OrgStatus @default(active)
  isDefault                     Boolean   @default(false)
  /// Subscription package (demo | starter | growth | enterprise). Null until entitled.
  subscriptionPlan              String?
  /// Landing /register-company?plan= interest only ? never entitles creates.
  requestedPlan                 String?
  /// Checkout term interest (1|2|3|6|12|24|60). Never entitles creates alone.
  requestedDurationMonths       Int?
  /// none | trialing | active | past_due | canceled | expired | ops_hold ? drives ops with status.
  subscriptionStatus            String?
  subscriptionEndsAt            DateTime?
  /// Stripe term label: month | year | N_month | N_year
  subscriptionInterval          String?
  subscriptionCancelAtPeriodEnd Boolean   @default(false)
  stripeCustomerId              String?   @unique
  stripeSubscriptionId          String?   @unique
  /// Last successfully applied Stripe event id (idempotency watermark aid).
  stripeBillingLastEventId      String?
  /// Unix seconds of last applied Stripe event.created (ordering watermark aid).
  stripeBillingLastEventCreated Int?
  /// Harewa storefront admin who approved a pending registered company.
  approvedAt                    DateTime?
  approvedById                  String?

  /// Step 4 ? soft offboard markers (no hard-delete of orders/payments/users).
  offboardRequestedAt DateTime?
  offboardedAt        DateTime?

  /// Step 3 ? subscription / ops-grant notice watermarks (dedupe email + in-app).
  subscriptionNoticePastDueAt   DateTime?
  subscriptionNoticeExpiredAt   DateTime?
  subscriptionNoticeRemind14dAt DateTime?
  subscriptionNoticeRemind7dAt  DateTime?
  subscriptionNoticeRemind3dAt  DateTime?
  subscriptionNoticeRemind1dAt  DateTime?
  opsGrantNoticeRemind14dAt     DateTime?
  opsGrantNoticeRemind7dAt      DateTime?
  opsGrantNoticeRemind3dAt      DateTime?
  opsGrantNoticeRemind1dAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taxSettings                TaxSettings?
  aiSettings                 AiSettings?
  companyProfile             CompanyProfile?
  adBannerSeedLock           AdBannerSeedLock?
