}

model BookingAccountContact {
  id        String   @id @default(cuid())
  accountId String
  orgId     String
  firstName String?
  lastName  String?
  email     String?
  phone     String?
  title     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account BookingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([orgId])
  @@map("booking_account_contacts")
}

model BookingActivity {
  id          String              @id @default(cuid())
  orgId       String
  locationId  String?
  bookingId   String
  kind        BookingActivityKind
  payload     Json?
  actorUserId String?
  createdAt   DateTime            @default(now())

  org      Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location VenueLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  booking  Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor    User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([orgId, createdAt])
  @@map("booking_activities")
