/// Period rollup cache rebuilt from JournalLine. locationKey "" = company-level.
model AccountBalance {
  id              String   @id @default(cuid())
  orgId           String
  ledgerAccountId String
  periodId        String
  locationKey     String   @default("")
  debitTotal      Decimal  @default(0) @db.Decimal(18, 2)
  creditTotal     Decimal  @default(0) @db.Decimal(18, 2)
  updatedAt       DateTime @updatedAt

  org     Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account LedgerAccount    @relation(fields: [ledgerAccountId], references: [id], onDelete: Cascade)
  period  AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([orgId, ledgerAccountId, periodId, locationKey])
  @@index([orgId, periodId])
  @@map("account_balances")
}

/// Posting outbox. Written in the source transaction; processed after commit.
model AccountingPostingQueue {
  id             String               @id @default(cuid())
  orgId          String
  locationId     String?
  sourceType     AccountingSourceType
  sourceId       String
  sourceEvent    String
  payload        Json                 @default("{}")
  eventAt        DateTime
  status         PostingQueueStatus   @default(pending)
  /// Bumped on every re-enqueue so a concurrent processor never drops a newer trigger.
  version        Int                  @default(0)
  attempts       Int                  @default(0)
  errorCode      String?
  lastError      String?
  warningCode    String?
  nextAttemptAt  DateTime             @default(now())
  journalEntryId String?
  skippedReason  String?
  skippedById    String?
  createdAt      DateTime             @default(now())
  processedAt    DateTime?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, sourceType, sourceId, sourceEvent])
  @@index([status, nextAttemptAt])
  @@index([orgId, status])
  @@map("accounting_posting_queue")
}

model AccountingSequence {
  id        String @id @default(cuid())
  orgId     String
  key       String
  nextValue Int    @default(1)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
  @@map("accounting_sequences")
}

