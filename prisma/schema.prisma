/// A party IS a booking: created in the same transaction as its Booking.
/// Balance is Booking.amountDue only — never a second balance column here.
model PartyBookingDetail {
  id                   String         @id @default(cuid())
  bookingId            String         @unique
  orgId                String
  locationId           String
  packageProductId     String?
  partyName            String         @default("Party")
  honoreeName          String?
  honoreeAge           Int?
  honoreeBirthDate     DateTime?
  kidCount             Int            @default(0)
  adultCount           Int            @default(0)
  roomResourceId       String?
  roomNameSnapshot     String?
  hostStaffUserId      String?
  hostNotes            String?
  opsStatus            PartyOpsStatus @default(inquiry)
  depositRequiredCents Int            @default(0)
  depositPaidCents     Int            @default(0)
  depositDueAt         DateTime?
  balanceDueAt         DateTime?
  foodNotes            String?
  waiverMissingCount   Int            @default(0)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  org              Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location         VenueLocation          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  booking          Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomResource     CapacityResource?      @relation(fields: [roomResourceId], references: [id], onDelete: SetNull)
  hostStaff        User?                  @relation("PartyHostStaff", fields: [hostStaffUserId], references: [id], onDelete: SetNull)
  packageProduct   AdmissionProduct?      @relation(fields: [packageProductId], references: [id], onDelete: SetNull)
  guests           PartyGuest[]
  invitations      PartyInvitation[]
  runSheetItems    PartyRunSheetItem[]
  foodOrders       PartyFoodOrder[]
  balanceReminders PartyBalanceReminder[]

  @@index([orgId])
  @@index([orgId, locationId, opsStatus])
  @@index([orgId, locationId, createdAt])
  @@index([orgId, locationId, bookingId])
  @@index([roomResourceId])
  @@map("party_booking_details")
}

model PartyGuest {
  id             String            @id @default(cuid())
  orgId          String
  locationId     String
  partyDetailId  String
  bookingGuestId String?           @unique
  kind           PartyGuestKind    @default(kid)
  name           String?
  age            Int?
  email          String?
  phone          String?
  invitationId   String?
  rsvpStatus     PartyInviteStatus @default(pending)
  /// Read-only mirror of the waivers lib (valid | missing | expired | … | n/a).
  waiverStatus   String            @default("n/a")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  org           Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location      VenueLocation      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  partyDetail   PartyBookingDetail @relation(fields: [partyDetailId], references: [id], onDelete: Cascade)
  bookingGuest  BookingGuest?      @relation(fields: [bookingGuestId], references: [id], onDelete: SetNull)
  waiverRecords WaiverRecord[]
  invitations   PartyInvitation[]

  @@index([partyDetailId])
  @@index([orgId, locationId])
  @@index([partyDetailId, kind])
  @@map("party_guests")
}

model PartyInvitation {
  id            String                 @id @default(cuid())
  orgId         String
  locationId    String
  partyDetailId String
  guestId       String?
  /// Public RSVP token (crypto random, base64url). There is no second token column.
  token         String                 @unique
  channel       PartyInvitationChannel @default(email)
  sentTo        String?
  toEmail       String?
  toPhone       String?
  status        PartyInviteStatus      @default(pending)
  sentAt        DateTime?
  respondedAt   DateTime?
  expiresAt     DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  org         Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location    VenueLocation      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  partyDetail PartyBookingDetail @relation(fields: [partyDetailId], references: [id], onDelete: Cascade)
  guest       PartyGuest?        @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([partyDetailId, status])
  @@index([orgId, locationId, status])
  @@index([expiresAt])
  @@map("party_invitations")
}

model PartyRunSheetItem {
  id            String    @id @default(cuid())
  orgId         String
  locationId    String
  partyDetailId String
  startsAt      DateTime?
  title         String
  notes         String?
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  org         Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location    VenueLocation      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  partyDetail PartyBookingDetail @relation(fields: [partyDetailId], references: [id], onDelete: Cascade)

  @@index([partyDetailId, sortOrder])
  @@index([orgId, locationId])
  @@map("party_run_sheet_items")
}

/// locationId null = org default. One org-default row per org is enforced by a partial unique index.
model PartySettings {
  id                          String              @id @default(cuid())
  orgId                       String
  locationId                  String?
  defaultDepositPercent       Decimal?            @db.Decimal(5, 2)
  defaultDepositFixedCents    Int?
  depositDueMode              PartyDepositDueMode @default(at_booking)
  depositDaysBefore           Int                 @default(0)
  requireDepositToConfirm     Boolean             @default(true)
  allowConfirmWithoutDeposit  Boolean             @default(false)
  balanceDueMode              PartyBalanceDueMode @default(on_arrival)
  balanceDaysBefore           Int                 @default(0)
  defaultPartyDurationMinutes Int                 @default(120)
  defaultMinKids              Int                 @default(1)
  defaultMaxKids              Int                 @default(15)
  defaultIncludedAdults       Int                 @default(2)
  invitationExpiresHours      Int                 @default(168)
  allowOnlinePartyBooking     Boolean             @default(true)
  allowHostEditGuestList      Boolean             @default(true)
  allowHostEditFood           Boolean             @default(false)
  foodOrderCutoffMinutes      Int                 @default(60)
  sendBalanceReminder         Boolean             @default(true)
  balanceReminderDaysBefore   Json                @default("[7,3,1]")
  hostCancelCutoffHours       Int                 @default(48)
  /// Venue rows only: field names that override the org default. Others inherit.
  overrideFields              Json                @default("[]")
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt

  org      Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location VenueLocation? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([orgId, locationId])
  @@index([orgId])
  @@map("party_settings")
}

/// Party-specific config for an AdmissionProduct of type party_package (1:1).
model PartyPackageConfig {
  id                        String   @id @default(cuid())
  orgId                     String
  locationId                String
  productId                 String   @unique
  durationMinutes           Int
  includedKids              Int
  includedAdults            Int
  extraKidPriceCents        Int?
  extraAdultPriceCents      Int?
  roomResourceId            String?
  roomAssignedAtBooking     Boolean  @default(false)
  depositPercentOverride    Decimal? @db.Decimal(5, 2)
  depositFixedCentsOverride Int?
  includesFood              Boolean  @default(false)
  defaultMenuItemIds        Json?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  org          Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location     VenueLocation     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product      AdmissionProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  roomResource CapacityResource? @relation("PartyPackageRoom", fields: [roomResourceId], references: [id], onDelete: SetNull)

  @@index([orgId, locationId])
  @@map("party_package_configs")
}

/// Party food / cake menu. Name is unique per location (case-insensitive) in code.
model PartyMenuItem {
  id           String            @id @default(cuid())
  orgId        String
  locationId   String
  name         String
  description  String?
  kind         PartyMenuItemKind @default(food)
  priceCents   Int
  currency     String            @default("usd")
  available    Boolean           @default(true)
  archivedAt   DateTime?
  /// Same-org, same-location PosProduct (validated in code).
  posProductId String?
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  org       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location  VenueLocation   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  foodLines PartyFoodLine[]

  @@index([orgId, locationId, available, archivedAt])
  @@map("party_menu_items")
}

model PartyFoodOrder {
  id                   String               @id @default(cuid())
  orgId                String
  locationId           String
  partyDetailId        String
  status               PartyFoodOrderStatus @default(draft)
  promisedAt           DateTime?
  kitchenTicketId      String?              @unique
  notes                String?
  submittedAt          DateTime?
  fulfilledAt          DateTime?
  cutoffOverrideReason String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  org           Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location      VenueLocation      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  partyDetail   PartyBookingDetail @relation(fields: [partyDetailId], references: [id], onDelete: Cascade)
  kitchenTicket KitchenTicket?     @relation(fields: [kitchenTicketId], references: [id], onDelete: SetNull)
  lines         PartyFoodLine[]

  @@index([orgId, locationId, status])
  @@index([partyDetailId])
  @@map("party_food_orders")
}

model PartyFoodLine {
  id             String   @id @default(cuid())
  orgId          String
  locationId     String
  foodOrderId    String
  menuItemId     String?
  posProductId   String?
  nameSnapshot   String
  qty            Int
  modifiers      Json?
  unitPriceCents Int
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org       Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location  VenueLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  foodOrder PartyFoodOrder @relation(fields: [foodOrderId], references: [id], onDelete: Cascade)
  menuItem  PartyMenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([foodOrderId])
  @@map("party_food_lines")
}

/// Scheduled deposit / balance reminders. Sending is wired by the maintenance job (Step 2).
model PartyBalanceReminder {
  id            String    @id @default(cuid())
  orgId         String
  locationId    String
  partyDetailId String
  /// deposit | balance
  kind          String
  scheduledFor  DateTime
  sentAt        DateTime?
  skippedReason String?
  createdAt     DateTime  @default(now())

  org         Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location    VenueLocation      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  partyDetail PartyBookingDetail @relation(fields: [partyDetailId], references: [id], onDelete: Cascade)

  @@unique([partyDetailId, kind, scheduledFor])
  @@index([scheduledFor, sentAt])
  @@map("party_balance_reminders")
}

// ?? Marketplace Connect payouts (World B) ??????????????????????????????????
// SaaS billing uses Organization.stripeCustomerId / stripeSubscriptionId.
// Never reuse those columns for Connect merchant accounts.

enum MarketplaceProvider {
  stripe_connect
  paystack
  manual
}

enum MarketplaceOnboardingStatus {
  not_started
  pending
  restricted
  complete
  disabled
}

enum MarketplaceBookingStatus {
  pending_payment
  paid
  failed
  refunded
  partially_refunded
  cancelled
  disputed
}

/// 1:1 Connect / sub-merchant account for a registered company (not DEFAULT_ORG).
model OrganizationMarketplaceAccount {
  id                       String                      @id @default(cuid())
  orgId                    String                      @unique
  provider                 MarketplaceProvider         @default(stripe_connect)
  stripeConnectedAccountId String?                     @unique
  chargesEnabled           Boolean                     @default(false)
  payoutsEnabled           Boolean                     @default(false)
  detailsSubmitted         Boolean                     @default(false)
  /// Redacted snapshot of Stripe currently_due / past_due (no secrets).
  requirementsDue          Json?
  payoutBankLast4          String?
  payoutBankName           String?
  defaultCurrency          String                      @default("usd")
  onboardingStatus         MarketplaceOnboardingStatus @default(not_started)
  disabledReason           String?
  /// Ops-only per-org application fee override (basis points). Null = env default.
  platformFeeBpsOverride   Int?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([stripeConnectedAccountId])
  @@map("organization_marketplace_accounts")
}

/// 1:1 Connect / sub-merchant for a franchise VenueLocation (Step 3).
/// Never a SaaS Stripe Customer. Only franchise parks may onboard.
model VenueLocationMarketplaceAccount {
  id                       String                      @id @default(cuid())
  orgId                    String
  locationId               String                      @unique
  provider                 MarketplaceProvider         @default(stripe_connect)
  stripeConnectedAccountId String?                     @unique
  chargesEnabled           Boolean                     @default(false)
  payoutsEnabled           Boolean                     @default(false)
  detailsSubmitted         Boolean                     @default(false)
  /// Redacted snapshot of Stripe currently_due / past_due (no secrets).
  requirementsDue          Json?
  payoutBankLast4          String?
  payoutBankName           String?
  defaultCurrency          String                      @default("usd")
  onboardingStatus         MarketplaceOnboardingStatus @default(not_started)
  disabledReason           String?
  /// Ops-only per-park application fee override (basis points). Null = env/org default.
  platformFeeBpsOverride   Int?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  org      Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location VenueLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([stripeConnectedAccountId])
  @@map("venue_location_marketplace_accounts")
}

/// Minimal sellable catalog for Connect destination-charge proof path.
model BookingPackage {
  id          String    @id @default(cuid())
  orgId       String
  locationId  String?
  slug        String
  title       String
  description String?
  amountMinor Int
  /// ISO 4217 lowercase (v1: usd ? see DEFAULT_MARKETPLACE_CURRENCY).
  currency    String    @default("usd")
  /// null = unlimited
  capacity    Int?
  active      Boolean   @default(true)
  published   Boolean   @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org      Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location VenueLocation?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  bookings MarketplaceBooking[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@index([orgId, published, active])
  @@index([locationId])
  @@map("booking_packages")
}

/// Guest reservation / order for a BookingPackage (Connect destination charge).
model MarketplaceBooking {
  id                      String                   @id @default(cuid())
  orgId                   String
  locationId              String?
  packageId               String
  customerUserId          String?
  customerEmail           String
  customerName            String?
  amountMinor             Int
  currency                String
  platformFeeMinor        Int
  status                  MarketplaceBookingStatus @default(pending_payment)
  stripeCheckoutSessionId String?                  @unique
  stripePaymentIntentId   String?                  @unique
  stripeChargeId          String?
  stripeTransferId        String?
  connectedAccountId      String
  idempotencyKey          String                   @unique
  paidAt                  DateTime?
  /// Safe fields only ? never PAN / bank ciphertext.
  metadata                Json?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  org     Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  package BookingPackage            @relation(fields: [packageId], references: [id], onDelete: Restrict)
  events  MarketplacePaymentEvent[]
  refunds MarketplaceRefund[]

  @@index([orgId])
  @@index([orgId, status])
  @@index([packageId])
  @@index([customerEmail])
  @@map("marketplace_bookings")
}

/// Immutable webhook / settlement audit row (idempotent by providerEventId).
model MarketplacePaymentEvent {
  id               String   @id @default(cuid())
  orgId            String
  bookingId        String?
  providerEventId  String   @unique
  type             String
  payloadRedacted  Json
  processedAt      DateTime @default(now())
  processingResult String

  org     Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  booking MarketplaceBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([bookingId])
  @@map("marketplace_payment_events")
}

model MarketplaceRefund {
  id                   String   @id @default(cuid())
  orgId                String
  bookingId            String
  amountMinor          Int
  currency             String
  stripeRefundId       String?  @unique
  reason               String?
  actorUserId          String?
  /// Whether application fee was refunded proportionally / fully.
  refundApplicationFee Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  org     Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  booking MarketplaceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([bookingId])
  @@map("marketplace_refunds")
}

// --- Guest park Memberships (Feature 08) -------------------------------------
// Distinct from staff Membership seats. Do not reuse fashion Product/Order/Wallet
// or Organization.stripeCustomerId for guest recurring billing.

enum MembershipPlanBilling {
  recurring
  fixed
}

enum MembershipIntervalUnit {
  day
  week
  month
  year
}

/// ROLLER-style membership product type (single guest vs group/family).
enum MembershipPlanType {
  single
  group
}

enum GuestMembershipStatus {
  active
  past_due
  paused
  cancelled
  expired
  pending
}

/// Multi-venue visit label (computed and/or stored snapshot).
enum MembershipVisitStatus {
  CURRENT
  VISITING
  INELIGIBLE
}

enum MembershipPaymentAttemptStatus {
  pending
  succeeded
  failed
  skipped
  cancelled
}

enum MembershipSellChannel {
  admin
  pos
  online
  other
}

enum MembershipUsageKind {
  visit
  redeem
  discount_applied
  perk_consumed
  free_product
  adjustment
  undo
}

enum MembershipUsageSource {
  admin
  pos
  checkin
  online
  system
}

enum MembershipFamilyRole {
  primary
  dependent
}

enum MembershipAgreementStatus {
  draft
  signed
  void
}

enum MembershipCancelAlternativeKind {
  pause_offer
  discount
  downgrade
  message
}

/// Park CRM hub ? not shop Profile, not staff Membership.
model GuestProfile {
  id                     String    @id @default(cuid())
  orgId                  String
  locationId             String?
  /// Optional link to existing User — invite/auto-link may set; never via /signup.
  userId                 String?
  firstName              String
  lastName               String
  email                  String?
  phone                  String?
  dateOfBirth            DateTime?
  photoUrl               String?
  postalCode             String?
  /// Guest Stripe Customer for membership recurring (NOT Organization SaaS customer).
  stripeCustomerId       String?
  bannedAt               DateTime?
  bannedReason           String?
  notes                  String?
  /// Promotional marketing consent (unset/false = not opted-in).
  marketingEmailOptIn    Boolean   @default(false)
  marketingSmsOptIn      Boolean   @default(false)
  marketingOptInAt       DateTime?
  marketingOptInSource   String?
  newsletterSubscribedAt DateTime?
  firstVisitAt           DateTime?
  lastVisitAt            DateTime?
  lastMarketingEmailAt   DateTime?
  welcomeEmailSentAt     DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  createdById            String?

  org       Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location  VenueLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  user      User?          @relation("GuestProfileUser", fields: [userId], references: [id], onDelete: SetNull)
  createdBy User?          @relation("GuestProfileCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  guestMemberships            GuestMembership[]
  familyLinks                 MembershipFamilyLink[]
  usageEvents                 MembershipUsageEvent[]
  agreements                  MembershipAgreement[]
  waiverRecords               WaiverRecord[]               @relation("WaiverRecordGuest")
  waiverRecordsGuarded        WaiverRecord[]               @relation("WaiverRecordGuardian")
  waiverSigners               WaiverSigner[]
  waiverRequests              WaiverRequest[]
  waiverWalkinPasses          WaiverWalkinPass[]
  formResponses               FormResponse[]
  guestBans                   GuestBan[]
  parkWallets                 ParkWallet[]
  cashlessAccounts            CashlessAccount[]
  posCarts                    PosCart[]
  posSales                    PosSale[]
  giftCardsIssued             GiftCard[]                   @relation("GiftCardIssuedToGuest")
  marketingConsents           GuestMarketingConsent[]
  marketingSendLogs           MarketingSendLog[]
  marketingAutomationRuns     MarketingAutomationRun[]
  marketingCampaignRecipients MarketingCampaignRecipient[]
  surveyInvites               GuestSurveyInvite[]
  surveyResponses             GuestSurveyResponse[]

  @@index([orgId])
  @@index([orgId, email])
  @@index([orgId, phone])
  @@index([orgId, lastName, firstName])
  @@index([orgId, locationId])
  @@index([orgId, dateOfBirth])
  @@index([orgId, marketingEmailOptIn])
  @@index([orgId, lastVisitAt])
  @@index([userId])
  @@map("guest_profiles")
}

/// Sellable guest membership plan catalog (NOT staff Membership).
model MembershipPlan {
  id                          String                  @id @default(cuid())
  orgId                       String
  /// null = org-default plan; park-specific plans allowed.
  locationId                  String?
  name                        String
  description                 String?
  billing                     MembershipPlanBilling
  /// Flexible cycle: intervalCount + intervalUnit (e.g. 1 month, 3 month, 14 day).
  intervalCount               Int?
  intervalUnit                MembershipIntervalUnit?
  price                       Decimal                 @db.Decimal(12, 2)
  currency                    String                  @default("USD")
  /// SSOT entitlements: entries/visits, discountPercent, guestCount, perks, freeProductRefs, ?
  entitlements                Json                    @default("{}")
  familyAllowed               Boolean                 @default(false)
  upgradeGroupKey             String?
  agreementRequired           Boolean                 @default(false)
  pauseAllowed                Boolean                 @default(true)
  /// Content / merchandising (ROLLER create-membership map).
  membershipType              MembershipPlanType      @default(single)
  detailedDescription         String?
  physicalPassMessage         String?
  imageUrl                    String?
  tags                        String[]                @default([])
  /// Sales availability
  daysValidFromPurchase       Int?
  daysValidFromRedemption     Int?
  redemptionStartsAt          DateTime?
  redemptionEndsAt            DateTime?
  customRedemptionDescription String?
  salesStartsAt               DateTime?
  salesEndsAt                 DateTime?
  hideFromOnlineSales         Boolean                 @default(false)
  /// Additional options (hooks — add-ons/forms modules not fake-implemented).
  addOnsEnabled               Boolean                 @default(false)
  alternateAddress            String?
  cancellationTerms           String?
  formsEnabled                Boolean                 @default(false)
  instructions                String?
  /// Optional GL / reporting label (legacy free-text). Prefer categoryId for catalog folders.
  reportingCategory           String?
  /// Membership catalog folder (org-scoped; distinct from shop ProductCategory).
  categoryId                  String?
  overrideTax                 Boolean                 @default(false)
  termsAndConditions          String?
  /// Variations: [{ name, sell, price, frequency, payments }] — primary price/billing stay SSOT for sell.
  variations                  Json                    @default("[]")
  archivedAt                  DateTime?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt

  org      Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location VenueLocation?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  category MembershipCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  guestMemberships GuestMembership[]
  venueEligibility MembershipVenueEligibility[]
  agreements       MembershipAgreement[]
  posProducts      PosProduct[]

  @@index([orgId])
  @@index([orgId, archivedAt])
  @@index([orgId, locationId])
  @@index([orgId, upgradeGroupKey])
  @@index([orgId, hideFromOnlineSales])
  @@index([orgId, categoryId])
  @@map("membership_plans")
}

/// Org-scoped membership catalog folders (NOT shop ProductCategory).
model MembershipCategory {
  id          String    @id @default(cuid())
  orgId       String
  name        String
  description String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org        Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plans      MembershipPlan[]
  publicPage PublicCategoryPage?

  @@unique([orgId, name])
  @@index([orgId, archivedAt])
  @@map("membership_categories")
}

/// Org-scoped Online Booking / ticketing folders (NOT shop ProductCategory).
model BookingCategory {
  id          String    @id @default(cuid())
  orgId       String
  name        String
  description String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org               Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  admissionProducts AdmissionProduct[]
  publicPage        PublicCategoryPage?

  @@unique([orgId, name])
  @@index([orgId, archivedAt])
  @@map("booking_categories")
}

/// One white-label page per booking, menu, or membership category.
/// The storefront org (Organization.isDefault) does not get a row.
enum PublicCategoryKind {
  booking
  menu
  membership
}

enum PublicCategoryLayout {
  auto
  grid
  stack
}

model PublicCategoryPage {
  id                   String               @id @default(cuid())
  orgId                String
  kind                 PublicCategoryKind
  bookingCategoryId    String?              @unique
  membershipCategoryId String?              @unique
  productCategoryId    String?              @unique
  slug                 String
  layout               PublicCategoryLayout @default(auto)
  embedEnabled         Boolean              @default(true)
  active               Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  org                Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bookingCategory    BookingCategory?    @relation(fields: [bookingCategoryId], references: [id], onDelete: Cascade)
  membershipCategory MembershipCategory? @relation(fields: [membershipCategoryId], references: [id], onDelete: Cascade)
  productCategory    ProductCategory?    @relation(fields: [productCategoryId], references: [id], onDelete: Cascade)

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("public_category_pages")
}

/// https origins allowed to frame this company's category embed (Step 3+).
model CompanyEmbedOrigin {
  id        String   @id @default(cuid())
  orgId     String
  origin    String
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, origin])
  @@index([orgId])
  @@map("company_embed_origins")
}

model GuestMembership {
  id                   String                 @id @default(cuid())
  orgId                String
  /// Sell / stamp location (often equals home).
  locationId           String
  /// Explicit home venue for multi-venue status (CURRENT / VISITING / INELIGIBLE).
  homeLocationId       String
  guestProfileId       String
  planId               String
  status               GuestMembershipStatus  @default(pending)
  startsAt             DateTime?
  endsAt               DateTime?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  /// Guest Stripe Subscription ? NOT Organization.stripeSubscriptionId.
  stripeSubscriptionId String?
  stripePriceId        String?
  customMembershipId   String
  barcodeOrCode        String?
  qrPayload            String?
  photoUrl             String?
  familyEntitlements   Json?
  createdFromSaleId    String?
  /// Sell idempotency key (often equals createdFromSaleId / client key).
  sellIdempotencyKey   String?
  source               MembershipSellChannel  @default(admin)
  pauseStartsAt        DateTime?
  pauseEndsAt          DateTime?
  cancelAtPeriodEnd    Boolean                @default(false)
  cancelledAt          DateTime?
  cancelReason         String?
  /// Credit balance in minor units (cents).
  creditBalanceMinor   Int                    @default(0)
  /// Smart dunning (Phase 2): next retry wall-clock; fail count since past_due.
  dunningNextAt        DateTime?
  dunningFailCount     Int                    @default(0)
  agreementSignedAt    DateTime?
  agreementRecordId    String?
  /// Last computed multi-venue visit label (Phase 3 engine updates).
  visitStatus          MembershipVisitStatus?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  org          Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location     VenueLocation  @relation("GuestMembershipSellLocation", fields: [locationId], references: [id], onDelete: Restrict)
  homeLocation VenueLocation  @relation("GuestMembershipHomeLocation", fields: [homeLocationId], references: [id], onDelete: Restrict)
  guestProfile GuestProfile   @relation(fields: [guestProfileId], references: [id], onDelete: Restrict)
  plan         MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  familyLinks     MembershipFamilyLink[]
  usageEvents     MembershipUsageEvent[]
  paymentAttempts MembershipPaymentAttempt[]
  agreements      MembershipAgreement[]

  @@unique([orgId, customMembershipId])
  @@unique([orgId, sellIdempotencyKey])
  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, guestProfileId])
  @@index([orgId, planId])
  @@index([orgId, locationId])
  @@index([orgId, homeLocationId])
  @@index([orgId, dunningNextAt])
  @@index([stripeSubscriptionId])
  @@map("guest_memberships")
}

model MembershipFamilyLink {
  id                String               @id @default(cuid())
  orgId             String
  guestMembershipId String
  guestProfileId    String
  role              MembershipFamilyRole @default(dependent)
  createdAt         DateTime             @default(now())

  org             Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  guestMembership GuestMembership @relation(fields: [guestMembershipId], references: [id], onDelete: Cascade)
  guestProfile    GuestProfile    @relation(fields: [guestProfileId], references: [id], onDelete: Cascade)

  @@unique([guestMembershipId, guestProfileId])
  @@index([orgId])
  @@index([orgId, guestMembershipId])
  @@map("membership_family_links")
}

model MembershipUsageEvent {
  id                String                @id @default(cuid())
  orgId             String
  locationId        String
  guestMembershipId String
  guestProfileId    String?
  kind              MembershipUsageKind
  qty               Int                   @default(1)
  remainingAfter    Int?
  meta              Json?
  actorUserId       String?
  source            MembershipUsageSource @default(admin)
  createdAt         DateTime              @default(now())

  org             Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location        VenueLocation   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  guestMembership GuestMembership @relation(fields: [guestMembershipId], references: [id], onDelete: Cascade)
  guestProfile    GuestProfile?   @relation(fields: [guestProfileId], references: [id], onDelete: SetNull)

  @@index([orgId, guestMembershipId, createdAt])
  @@index([orgId, locationId, createdAt])
  @@index([orgId, kind, createdAt])
  @@map("membership_usage_events")
}

model MembershipVenueEligibility {
  id               String   @id @default(cuid())
  orgId            String
  planId           String
  locationId       String
  eligible         Boolean  @default(true)
  localPerksAdd    Json?
  localPerksRemove Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  org      Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan     MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  location VenueLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([planId, locationId])
  @@index([orgId])
  @@index([orgId, planId])
  @@map("membership_venue_eligibility")
}

model MembershipSettings {
  id                           String   @id @default(cuid())
  orgId                        String
  /// null = org-default settings for the company. At most one null row per org
  /// enforced by partial unique index `membership_settings_org_default_uidx`.
  locationId                   String?
  requirePhotoOnRedeem         Boolean  @default(false)
  requireAgreementBeforeActive Boolean  @default(false)
  dunningEnabled               Boolean  @default(true)
  clickToCancelEnabled         Boolean  @default(true)
  cancelAlternativesEnabled    Boolean  @default(true)
  graceDays                    Int?
  allowPause                   Boolean  @default(true)
  walletPassEnabled            Boolean  @default(false)
  /// Default home venue suggestion when selling (optional).
  defaultHomeLocationId        String?
  other                        Json?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  org      Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location VenueLocation? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([orgId, locationId])
  @@index([orgId])
  @@map("membership_settings")
}

model MembershipPaymentAttempt {
  id                    String                         @id @default(cuid())
  orgId                 String
  guestMembershipId     String
  /// Park stamp from plan/sale location when Connect destination was used (Step 3).
  locationId            String?
  stripeInvoiceId       String?
  stripePaymentIntentId String?
  /// Connect destination snapshot (park or org) when applicable.
  connectedAccountId    String?
  platformFeeMinor      Int?
  amount                Decimal                        @db.Decimal(12, 2)
  currency              String                         @default("USD")
  status                MembershipPaymentAttemptStatus @default(pending)
  attemptNumber         Int                            @default(1)
  errorCode             String?
  errorMessage          String?
  /// Optional client/webhook idempotency (unique per org when set).
  idempotencyKey        String?
  createdAt             DateTime                       @default(now())

  org             Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  guestMembership GuestMembership @relation(fields: [guestMembershipId], references: [id], onDelete: Cascade)

  @@unique([orgId, idempotencyKey])
  @@index([orgId, guestMembershipId, createdAt])
  @@index([orgId, status])
  @@index([orgId, locationId])
  @@map("membership_payment_attempts")
}

model MembershipCancelAlternative {
  id         String                          @id @default(cuid())
  orgId      String
  locationId String?
  name       String
  kind       MembershipCancelAlternativeKind
  config     Json                            @default("{}")
  active     Boolean                         @default(true)
  sortOrder  Int                             @default(0)
  createdAt  DateTime                        @default(now())
  updatedAt  DateTime                        @updatedAt

  org      Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location VenueLocation? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([orgId, active, sortOrder])
  @@map("membership_cancel_alternatives")
}

model MembershipAgreement {
  id                String                    @id @default(cuid())
  orgId             String
  guestMembershipId String?
  guestProfileId    String
  planId            String?
  status            MembershipAgreementStatus @default(draft)
  signedAt          DateTime?
  bodyVersion       String?
  storageRef        String?
  /// Signed Digital Waiver record when the membership contract was captured there.
  waiverRecordId    String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  org             Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  guestMembership GuestMembership? @relation(fields: [guestMembershipId], references: [id], onDelete: SetNull)
  guestProfile    GuestProfile     @relation(fields: [guestProfileId], references: [id], onDelete: Cascade)
  plan            MembershipPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  waiverRecord    WaiverRecord?    @relation(fields: [waiverRecordId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([orgId, guestProfileId])
  @@index([guestMembershipId])
  @@index([waiverRecordId])
  @@map("membership_agreements")
}

// --- Digital Waivers (Feature 05) — not shop Product / staff Membership ---

enum WaiverDocumentKind {
  liability_waiver
  membership_contract
  booking_agreement
  custom_form
  inquiry
  event_form
  product_addon_form
}

enum WaiverTemplateStatus {
  draft
  published
  archived
}

enum WaiverRecordStatus {
  pending
  signed
  expired
  declined
  voided
  revoked
}

enum WaiverSignerRole {
  adult_self
  guardian
  staff_assisted
  imported
}

/// Person covered on a WaiverRecord (distinct from WaiverSignerRole on the record).
enum WaiverCoveredRole {
  adult_self
  minor
  guardian
}

enum WaiverSignChannel {
  online
  email_link
  sms_link
  qr
  kiosk
  onsite
  import
}

enum WaiverExpiryRule {
  never
  days
  calendar_year
  visit
  until_date
}

enum WaiverRequestStatus {
  queued
  sent
  failed
  opened
  completed
  cancelled
  expired
}

enum WaiverKioskStatus {
  active
  disabled
  archived
}

enum FormResponseStatus {
  submitted
  archived
}

enum WaiverRequirementEnforcement {
  warn
  block
}

enum WaiverLinkTargetType {
  guest
  booking
  party_guest
  pos_sale
  admission_product
  pos_product
  membership_plan
  party_package
  all_admissions
  other
}

/// Per location; locationId null = org default. One null row per org via partial unique index.
model WaiverSettings {
  id                          String           @id @default(cuid())
  orgId                       String
  locationId                  String?
  jurisdictionCode            String           @default("US-FL")
  ageOfMajorityYears          Int              @default(18)
  requireGuardianForMinors    Boolean          @default(true)
  allowAdultSelfSign          Boolean          @default(true)
  allowGroupSigning           Boolean          @default(true)
  maxMinorsPerGuardianSession Int              @default(8)
  expiryRule                  WaiverExpiryRule @default(calendar_year)
  expiryDays                  Int?
  remindBeforeDays            Json             @default("[14,3]")
  retentionYears              Int              @default(7)
  requireIntentCheckbox       Boolean          @default(true)
  allowTypedSignature         Boolean          @default(true)
  allowDrawnSignature         Boolean          @default(true)
  optionalWitness             Boolean          @default(false)
  blockCheckInWhenMissing     Boolean          @default(true)
  kioskRequireStaffPin        Boolean          @default(true)
  kioskSessionMinutes         Int              @default(5)
  defaultLocale               String           @default("en")
  /// Optional staff copy address. VenueLocation has no email column.
  notifyEmail                 String?
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt

  org      Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location VenueLocation? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([orgId, locationId])
  @@index([orgId])
  @@map("waiver_settings")
}

model WaiverTemplate {
  id                        String               @id @default(cuid())
  orgId                     String
  locationId                String?
  kind                      WaiverDocumentKind
  name                      String
  slug                      String
  status                    WaiverTemplateStatus @default(draft)
  currentPublishedVersionId String?              @unique
  requireResignOnPublish    Boolean              @default(false)
  defaultExpiryRule         WaiverExpiryRule?
  defaultExpiryDays         Int?
  archivedAt                DateTime?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  createdById               String?

  org                     Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location                VenueLocation?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy               User?                   @relation("WaiverTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  currentPublishedVersion WaiverTemplateVersion?  @relation("WaiverCurrentPublished", fields: [currentPublishedVersionId], references: [id], onDelete: SetNull)
  versions                WaiverTemplateVersion[] @relation("WaiverTemplateVersions")
  requirements            WaiverRequirement[]
  records                 WaiverRecord[]
  requests                WaiverRequest[]
  formResponses           FormResponse[]
  signageTokens           WaiverSignageToken[]

  @@unique([orgId, slug])
  @@index([orgId, locationId])
  @@index([orgId, kind, status])
  @@map("waiver_templates")
}

model WaiverTemplateVersion {
  id                   String               @id @default(cuid())
  orgId                String
  templateId           String
  version              Int
  localeDefault        String
  status               WaiverTemplateStatus @default(draft)
  publishedAt          DateTime?
  publishedById        String?
  title                String
  bodyHtml             String
  fieldsJson           Json?
  layoutId             String               @default("classic")
  displayMode          String               @default("single_page")
  allowDocumentExtract Boolean              @default(false)
  /// Null inherits location or org WaiverSettings. True or false is this version's choice.
  allowTypedSignature  Boolean?
  allowDrawnSignature  Boolean?
  contentSha256        String
  createdAt            DateTime             @default(now())

  org           Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  template      WaiverTemplate         @relation("WaiverTemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  publishedBy   User?                  @relation("WaiverVersionPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  currentFor    WaiverTemplate?        @relation("WaiverCurrentPublished")
  locales       WaiverTemplateLocale[]
  records       WaiverRecord[]
  formResponses FormResponse[]
  signatures    WaiverSignature[]

  @@unique([templateId, version])
  @@index([orgId, templateId])
  @@map("waiver_template_versions")
}

model WaiverTemplateLocale {
  id                   String   @id @default(cuid())
  orgId                String
  versionId            String
  locale               String
  title                String
  bodyHtml             String
  fieldsJson           Json?
  layoutId             String   @default("classic")
  displayMode          String   @default("single_page")
  allowDocumentExtract Boolean  @default(false)
  createdAt            DateTime @default(now())

  org     Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  version WaiverTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, locale])
  @@index([orgId])
  @@map("waiver_template_locales")
}

model WaiverRequirement {
  id          String                       @id @default(cuid())
  orgId       String
  locationId  String?
  templateId  String
  targetType  WaiverLinkTargetType
  targetId    String?
  enforcement WaiverRequirementEnforcement @default(block)
  required    Boolean                      @default(true)
  sortOrder   Int                          @default(0)
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  org      Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location VenueLocation? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  template WaiverTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([orgId, targetType, targetId])
  @@index([orgId, locationId])
  @@index([templateId])
  @@map("waiver_requirements")
}

model WaiverRecord {
  id                     String             @id @default(cuid())
  orgId                  String
  locationId             String
  guestProfileId         String
  templateId             String
  templateVersionId      String
  status                 WaiverRecordStatus @default(pending)
  signerRole             WaiverSignerRole
  channel                WaiverSignChannel
  locale                 String
  signedAt               DateTime?
  expiresAt              DateTime?
  declinedAt             DateTime?
  voidedAt               DateTime?
  voidReason             String?
  voidedById             String?
  guardianGuestProfileId String?
  guardianRelationship   String?
  bookingId              String?
  partyGuestId           String?
  posSaleId              String?
  importedFrom           String?
  /// Historical import key. Unique per company when set. Null for live signatures.
  externalRef            String?
  /// Shared id for one guardian session. One WaiverRecord per covered person.
  waiverGroupId          String?
  /// How the guest filled the form. Null until a later sign flow sets it.
  fillMethod             String?
  publicRef              String             @unique
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  org                  Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location             VenueLocation             @relation(fields: [locationId], references: [id], onDelete: Cascade)
  guestProfile         GuestProfile              @relation("WaiverRecordGuest", fields: [guestProfileId], references: [id], onDelete: Cascade)
  guardian             GuestProfile?             @relation("WaiverRecordGuardian", fields: [guardianGuestProfileId], references: [id], onDelete: SetNull)
  template             WaiverTemplate            @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersion      WaiverTemplateVersion     @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  voidedBy             User?                     @relation("WaiverRecordVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  booking              Booking?                  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  partyGuest           PartyGuest?               @relation(fields: [partyGuestId], references: [id], onDelete: SetNull)
  signers              WaiverSigner[]
  signatures           WaiverSignature[]
  formResponses        FormResponse[]
  membershipAgreements MembershipAgreement[]
  reminderWatermarks   WaiverReminderWatermark[]

  @@unique([orgId, externalRef])
  @@index([orgId, locationId, status])
  @@index([orgId, guestProfileId])
  @@index([orgId, expiresAt])
  @@index([orgId, locationId, createdAt])
  @@index([bookingId])
  @@index([partyGuestId])
  @@index([waiverGroupId])
  @@map("waiver_records")
}

model WaiverSigner {
  id             String            @id @default(cuid())
  orgId          String
  waiverRecordId String
  guestProfileId String?
  fullName       String
  dateOfBirth    DateTime?
  isMinor        Boolean           @default(false)
  role           WaiverCoveredRole
  createdAt      DateTime          @default(now())

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  waiverRecord WaiverRecord  @relation(fields: [waiverRecordId], references: [id], onDelete: Cascade)
  guestProfile GuestProfile? @relation(fields: [guestProfileId], references: [id], onDelete: SetNull)

  @@index([orgId, waiverRecordId])
  @@index([guestProfileId])
  @@map("waiver_signers")
}

/// Append-only signing audit. Never overwrite a row.
model WaiverSignature {
  id                String   @id @default(cuid())
  orgId             String
  waiverRecordId    String
  signedAt          DateTime
  timezone          String
  intentAccepted    Boolean
  typedName         String?
  drawnSignatureSvg String?
  witnessName       String?
  ipHash            String?
  userAgent         String?
  locale            String   @default("en")
  templateVersionId String?
  contentSha256     String
  /// Accepted clause ids and labels. Null until a later sign flow stores them.
  acceptedClauses   Json?
  createdAt         DateTime @default(now())

  org             Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  waiverRecord    WaiverRecord           @relation(fields: [waiverRecordId], references: [id], onDelete: Cascade)
  templateVersion WaiverTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)

  @@index([orgId, waiverRecordId, createdAt])
  @@map("waiver_signatures")
}

model WaiverRequest {
  id                String              @id @default(cuid())
  orgId             String
  locationId        String
  templateId        String
  guestProfileId    String?
  toEmail           String?
  toPhone           String?
  channel           WaiverSignChannel
  status            WaiverRequestStatus @default(queued)
  publicTokenHash   String              @unique
  locale            String              @default("en")
  providerMessageId String?
  waiverGroupId     String?
  expiresAt         DateTime
  sentAt            DateTime?
  lastRemindedAt    DateTime?
  createdById       String?
  bookingId         String?
  partyGuestId      String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  org          Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location     VenueLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  template     WaiverTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  guestProfile GuestProfile?  @relation(fields: [guestProfileId], references: [id], onDelete: SetNull)
  createdBy    User?          @relation("WaiverRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orgId, locationId, createdAt])
  @@index([orgId, status])
  @@map("waiver_requests")
}

model WaiverKioskDevice {
  id              String            @id @default(cuid())
  orgId           String
  locationId      String
  name            String
  code            String
  status          WaiverKioskStatus @default(active)
  deviceTokenHash String            @unique
  pinHash         String?
  templateIds     Json              @default("[]")
  lastSeenAt      DateTime?
  archivedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  org      Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location VenueLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([orgId, code])
  @@index([orgId, locationId])
  @@map("waiver_kiosk_devices")
}

/// Standing venue QR. Raw token is HMAC(secret, nonce); only the hash is stored.
model WaiverSignageToken {
  id         String    @id @default(cuid())
  orgId      String
  locationId String
  templateId String
  nonce      String
  tokenHash  String    @unique
  kind       String    @default("signage")
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  org      Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location VenueLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  template WaiverTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([orgId, locationId, templateId])
  @@index([orgId, locationId])
  @@map("waiver_signage_tokens")
}

/// One row per reminder window already sent for a signed waiver.
model WaiverReminderWatermark {
  id         String   @id @default(cuid())
  orgId      String
  recordId   String
  windowDays Int
  remindedAt DateTime @default(now())

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  record WaiverRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([recordId, windowDays])
  @@index([orgId])
  @@map("waiver_reminder_watermarks")
}

model FormResponse {
  id                String             @id @default(cuid())
  orgId             String
  locationId        String?
  templateId        String
  templateVersionId String
  waiverRecordId    String?
  guestProfileId    String?
  status            FormResponseStatus @default(submitted)
  payloadJson       Json
  submittedAt       DateTime
  locale            String
  source            WaiverSignChannel
  createdAt         DateTime           @default(now())

  org             Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location        VenueLocation?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  template        WaiverTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateVersion WaiverTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  waiverRecord    WaiverRecord?         @relation(fields: [waiverRecordId], references: [id], onDelete: SetNull)
  guestProfile    GuestProfile?         @relation(fields: [guestProfileId], references: [id], onDelete: SetNull)

  @@index([orgId, templateId, submittedAt])
  @@index([orgId, locationId])
  @@map("form_responses")
}

/// 90-minute kiosk or on-site walk-in pass. Public emailed links do not create one.
