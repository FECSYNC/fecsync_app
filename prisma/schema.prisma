// --- POS (Point of Sale) Step 1. Park commerce. Not shop Product/Cart/Order/Wallet. ---

enum GiftCardKind {
  digital
  physical
}

enum GiftCardStatus {
  active
  pending
  disabled
  expired
  void
}

enum GiftCardLedgerType {
  issue
  redeem
  refund
  adjust
  void
}

enum PosProductKind {
  admission_proxy
  food
  beverage
  merchandise
  open_price
  package
  party_package_proxy
  add_on
  gift_card
  membership_plan
  cashless_card
  park_wallet
  gratuity
  other
}

enum PosCartStatus {
  open
  parked
}

enum PosSaleStatus {
  open
  parked
  held_booking
  unpaid
  completed
  voided
  refunded
  partially_refunded
}

enum PosLineKind {
  sku
  open_price
  modifier
  package_component
  booking
  gift_card_issue
  gift_card_redeem
  membership
  cashless
  wallet
  discount
  tip
  round
  other
}

enum PosTenderType {
  card
  cash
  split_component
  gift_card
  park_wallet
  cashless
  stored_card
  payment_link
  other
}

enum PosPaymentStatus {
  pending
  authorized
  completed
  failed
  cancelled
  refunded
  partial_refund
}

enum TillSessionStatus {
  open
  counting
  closed
  closed_no_count
  void
}

enum TillMovementKind {
  open_float
  cash_in
  cash_out
  sale_cash
  refund_cash
  tip
  drop
  pickup
  other
}

enum CashlessAccountStatus {
  active
  disabled
  void
}

enum ParkWalletStatus {
  active
  disabled
  void
}

enum ParkWalletTxnType {
  issue
  topup
  redeem
  refund
  adjust
}

enum GuestTabStatus {
  open
  authorized
  settled
  voided
  split_child
}

enum PosOfflineMutationStatus {
  queued
  syncing
  applied
  conflict
  failed
  discarded
}

enum KitchenTicketStatus {
  queued
  sent
  accepted
  fulfilled
  void
}

enum PosDrawerResult {
  kicked
  not_kicked
}

model PosSettings {
  id                            String   @id @default(cuid())
  orgId                         String
  locationId                    String?
  captureGuestPostcode          Boolean  @default(false)
  postcodeRequired              Boolean  @default(false)
  requireGuestOnSale            Boolean  @default(false)
  allowOpenPrice                Boolean  @default(true)
  allowParkedCarts              Boolean  @default(true)
  allowUnpaidBookings           Boolean  @default(true)
  paidRequiredForRedeem         Boolean  @default(true)
  defaultReceiptEmail           Boolean  @default(true)
  printTicketsOnSale            Boolean  @default(true)
  showExpectedTillTotals        Boolean  @default(true)
  tipPromptEnabled              Boolean  @default(true)
  tipSuggestedPercents          Json     @default("[15,18,20]")
  managerPinRequiredForDiscount Boolean  @default(true)
  managerPinRequiredForRefund   Boolean  @default(true)
  managerPinRequiredForVoid     Boolean  @default(true)
  managerPinRequiredForWastage  Boolean  @default(true)
  offlineEnabled                Boolean  @default(true)
  cashRequiresOpenTill          Boolean  @default(true)
  lateRedemptionGraceMinutes    Int      @default(0)
  allowPastDateRedemption       Boolean  @default(false)
  bannedGuestPrompt             Boolean  @default(true)
  managerOverridePinHash        String?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  org      Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location VenueLocation? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([orgId, locationId])
  @@index([orgId])
  @@map("pos_settings")
}

model PosDevice {
