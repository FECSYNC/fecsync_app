model Membership {
  id                   String               @id @default(cuid())
  legacyId             String?              @unique
  userId               String
  orgId                String
  rolePreset           MembershipRolePreset
  roleTemplateId       String?
  permissionsOverride  String[]             @default([])
  companyWideView      Boolean              @default(false)
  /// Franchise park manager: park-locked seat may invite/manage staff inside assigned parks only.
  /// Never combine with platform_admin. Company SaaS billing stays company-wide.
  franchiseParkManager Boolean              @default(false)
  /// Enterprise HQ location scope preference (null = All locations). Validated against org venues on read/write ? not a second tenant.
  hqSelectedLocationId String?
  /// POS manager PIN. Never return pinHash on API payloads.
  pinHash              String?
  pinSetAt             DateTime?
  pinFailedAttempts    Int                  @default(0)
  pinLockedUntil       DateTime?
  status               MembershipStatus     @default(active)
  updatedById          String?
  updatedByName        String?
  invitedById          String?
  /// When status=invited ? seat frees after this (MEMBERSHIP_INVITE_DAYS, default 14).
  inviteExpiresAt      DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  user             User                        @relation(fields: [userId], references: [id])
  org              Organization                @relation(fields: [orgId], references: [id])
  roleTemplate     RoleTemplate?               @relation(fields: [roleTemplateId], references: [id])
  updatedBy        User?                       @relation("MembershipUpdatedBy", fields: [updatedById], references: [id])
  invitedBy        User?                       @relation("MembershipInvitedBy", fields: [invitedById], references: [id])
  venueAssignments MembershipVenueAssignment[]

  @@unique([userId, orgId])
  @@index([userId])
  @@index([orgId])
  @@index([status, inviteExpiresAt])
  @@map("memberships")
}

/// Park assignment for a staff Membership (same org). Unique per (membership, location).
/// Park-locked actors may only operate inside assigned VenueLocations.
/// orgId is denormalized and MUST equal membership.orgId.
model MembershipVenueAssignment {
  id           String   @id @default(cuid())
  membershipId String
  orgId        String
  locationId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  membership Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  org        Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location   VenueLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([membershipId, locationId])
  @@index([orgId, locationId])
  @@index([membershipId])
  @@index([locationId])
  @@map("membership_venue_assignments")
}

model RoleTemplate {
  id            String   @id @default(cuid())
  legacyId      String?  @unique
  orgId         String
  name          String
  description   String?
