/// Company newsletter broadcast — one-off or recurring monthly issue to opted-in guests.
model MarketingCampaign {
  id               String                        @id @default(cuid())
  orgId            String
  /// Null = whole company; set = only guests whose home park is this venue.
  locationId       String?
  name             String
  subject          String
  preheader        String?
  /// Ordered composer blocks (see src/lib/marketing/campaigns/blocks.ts).
  blocks           Json                          @default("[]")
  /// Audience filters (see src/lib/marketing/campaigns/audience.ts).
  audience         Json                          @default("{}")
  scheduleKind     MarketingCampaignScheduleKind @default(once)
  /// One-off send instant (scheduleKind = once).
  sendAt           DateTime?
  /// 1–28 (scheduleKind = monthly).
  dayOfMonth       Int?
  /// Local hour 0–23 in `timezone`.
  sendHour         Int                           @default(9)
  timezone         String                        @default("UTC")
  status           MarketingCampaignStatus       @default(draft)
  nextRunAt        DateTime?
  /// Issue being delivered: "YYYY-MM" for monthly, "once" for one-off.
  currentWindowKey String?
  lastRunAt        DateTime?
  lastCompletedAt  DateTime?
  createdById      String?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  org        Organization                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location   VenueLocation?               @relation(fields: [locationId], references: [id], onDelete: SetNull)
  recipients MarketingCampaignRecipient[]

  @@index([orgId, status])
  @@index([status, nextRunAt])
  @@map("marketing_campaigns")
}

/// One row per guest per issue — the unique key is the double-send guard.
model MarketingCampaignRecipient {
  id             String              @id @default(cuid())
  orgId          String
  campaignId     String
  guestProfileId String
  windowKey      String
  status         MarketingSendStatus
  skipReason     String?
  sendLogId      String?
  createdAt      DateTime            @default(now())

  org      Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  guest    GuestProfile      @relation(fields: [guestProfileId], references: [id], onDelete: Cascade)

  @@unique([campaignId, guestProfileId, windowKey])
  @@index([orgId, campaignId, windowKey])
  @@map("marketing_campaign_recipients")
}

