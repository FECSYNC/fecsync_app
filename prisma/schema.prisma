model Product {
  id               String        @id @default(cuid())
  legacyId         String?       @unique
  name             String
  description      String
  location         String
  price            Float
  quantity         Int
  remainingInStock Int           @default(0)
  discount         Float         @default(0)
  taxRate          Float?
  taxExempt        Boolean       @default(false)
  images           String[]      @default([])
  sizes            ProductSize[] @default([])
  gender           ProductGender
  categoryId       String
  fabricTypeId     String
  orgId            String
  /// Park stamp (nullable = company-shared). Do NOT confuse with `location` address TEXT.
  venueLocationId  String?
  sellerId         String?
  shopId           String?
  createdById      String?
  createdByName    String?
  updatedById      String?
  updatedByName    String?
  /// Weighted average unit cost (accounting inventory). Quantity stays in remainingInStock.
  avgCost          Decimal       @default(0) @db.Decimal(18, 4)
  lastCost         Decimal?      @db.Decimal(18, 4)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  org           Organization    @relation(fields: [orgId], references: [id])
  venueLocation VenueLocation?  @relation(fields: [venueLocationId], references: [id], onDelete: SetNull)
  inventoryMovements InventoryMovement[]
  category      ProductCategory @relation(fields: [categoryId], references: [id])
  fabricType    Fabric          @relation(fields: [fabricTypeId], references: [id])
  shop          Shop?           @relation(fields: [shopId], references: [id])
