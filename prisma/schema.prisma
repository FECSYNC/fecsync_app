  updatedAt        DateTime  @updatedAt

  org                  Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location             VenueLocation?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  contacts             BookingAccountContact[]
  bookings             Booking[]
  invoices             BookingInvoice[]
  storedPaymentMethods StoredPaymentMethod[]

  @@index([orgId, name])
  @@index([orgId, locationId])
