# Example environment variables (copy relevant keys into .env.local)
# Do not commit real secrets.

# Company SaaS — Profile bank encryption (Step 1)
# Required in production for bank account writes; local/dev may fall back to JWT_SECRET.
COMPANY_PROFILE_ENCRYPTION_KEY=

# Company SaaS Stripe Billing (Step 2)
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_GROWTH_MONTHLY=price_...
# Optional multi-month Prices (otherwise Checkout uses price_data = monthly × months):
# STRIPE_PRICE_STARTER_3M=price_...
# STRIPE_PRICE_STARTER_12M=price_...
# STRIPE_PRICE_GROWTH_12M=price_...
# STRIPE_PRICE_GROWTH_60M=price_...
# Optional — when unset, Enterprise CTA is Contact sales only
# STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
# Demo is free Stripe Checkout (no card). $0 Price in Stripe Dashboard (or inline fallback):
# COMPANY_DEMO_DAYS=30
# STRIPE_PRICE_DEMO_MONTHLY=price_...
# Days after paid subscriptionEndsAt before unpaid orgs demote to Demo (soft-hold + countdown meanwhile)
# COMPANY_BILLING_GRACE_DAYS=7
# After Demo trial ends (COMPANY_DEMO_DAYS): org suspends until ops Approve → Demo again
# STRIPE_COMPANY_BILLING_SUCCESS_URL=https://your-app/admin/billing?billing=success
# STRIPE_COMPANY_BILLING_CANCEL_URL=https://your-app/admin/billing?billing=cancel
# COMPANY_OPS_GRANT_DAYS=30
# Self-serve Checkout durations: 1|2|3|6|12|24|60 months (SSOT: src/lib/subscriptionPlans.ts)

# Company dashboard subdomains — each registered company's /admin opens at
# https://{orgSlug}.{root} (sign-in + marketing stay on the root host).
# Needs a wildcard DNS record (*.fecsync.com) and wildcard domain on the host (e.g. Vercel).
# Auth cookies become Domain={root} so one sign-in covers every company subdomain.
# Leave unset to keep every dashboard on the main host. Local test: lvh.me:3000
# NEXT_PUBLIC_TENANT_ROOT_DOMAIN=fecsync.com

# Company SaaS notices + cron (Step 3)
# COMPANY_BILLING_NOTICE_ENABLED=true
# COMPANY_OPS_ALERT_EMAIL=ops@your-domain.com
# CRON_SECRET=long-random-string
# MEMBERSHIP_INVITE_DAYS=14

# Marketplace Connect payouts (World B — separate from company_subscription SaaS)
# Application fee = floor(amountMinor * BPS / 10000) + FLAT (server-side only)
MARKETPLACE_PLATFORM_FEE_BPS=500
MARKETPLACE_PLATFORM_FEE_FLAT_MINOR=0
MARKETPLACE_CURRENCY_DEFAULT=usd
# Connect Express country for new payouts accounts (must support the currency above)
# MARKETPLACE_CONNECT_COUNTRY_DEFAULT=US
# Account Link return URLs (defaults: {APP}/admin/payouts?connect=return|refresh)
# STRIPE_CONNECT_RETURN_URL=https://your-app/admin/payouts?connect=return
# STRIPE_CONNECT_REFRESH_URL=https://your-app/admin/payouts?connect=refresh
# Prefer adding Connect events (account.updated, checkout.session.*, charge.dispute.created)
# to the same Stripe webhook endpoint as STRIPE_WEBHOOK_SECRET.
# Optional distinct secret only if you run a second endpoint (not required for v1):
# STRIPE_CONNECT_WEBHOOK_SECRET=
