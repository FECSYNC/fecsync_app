export type CoordinatorInviteeDto = {
  _id: string;
  fullName: string;
  email?: string;
  status: CampaignParticipantStatus;
  invitedAt: string;
  acceptedAt?: string;
  submittedAt?: string;
  joinPath?: string;
};

export type CampaignParticipantTreeNode = CampaignParticipantDto & {
  invitees: CampaignParticipantDto[];
};
